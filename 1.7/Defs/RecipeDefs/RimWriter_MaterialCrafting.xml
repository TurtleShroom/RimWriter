				</categories>
			  <thingDefs>
				<li>WoodLog</li>
				<li MayRequire="tsp.bathroomhumor">DungLog</li>
				<li MayRequire="sihv.rombones">BoneItem</li>
			  </thingDefs>
			  <disallowedThingDefs>
				<li MayRequire="dankpyon.medieval.overhaul">DankPyon_Mixture_Paper</li>
			  </disallowedThingDefs>
			</filter>
			<count>25</count>
		  </li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li MayRequire="dankpyon.medieval.overhaul">DankPyon_RawWood</li>
				<li MayRequire="dankpyon.medieval.overhaul">DankPyon_Wood</li>
