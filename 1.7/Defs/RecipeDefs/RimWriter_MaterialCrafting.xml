		  <li>RimWriter_PapermakingBenchElectric</li>
		</recipeUsers>
		<researchPrerequisites Inherit="False">
			<li>VBE_Printing</li>
			<li MayRequire="dankpyon.medieval.overhaul">DankPyon_Presser</li>
		</researchPrerequisites>
	</RecipeDef>
  
