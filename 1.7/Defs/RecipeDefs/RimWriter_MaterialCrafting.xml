		<label>press paper at electric paper bench</label>
		<workAmount>1200</workAmount>
		<products>
			<Jecrell_Paper>90</Jecrell_Paper>
		</products>
		<ingredients>
		  <li>
			<filter>
				<categories>
					<li MayRequire="dankpyon.medieval.overhaul">DankPyon_RawWood</li>
